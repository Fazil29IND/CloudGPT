# ============================================================================
# CloudGPT — Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in the values.
# Lines starting with # are comments and are ignored.
# ============================================================================

# ── Database & Auth ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5000/pygpt
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=30
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
SECRET_KEY=your-random-secret-key-here
CORS_ORIGINS=http://localhost:5001
TRUSTED_HOSTS=localhost,127.0.0.1
CSRF_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=30
BILLING_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=10
ENABLE_CLOUD_API_TOOLS=false
ENABLE_CONTEXT_SAFETY_BOUNDARY=true
ENABLE_TOOL_OUTPUT_NORMALIZATION=true
EVIDENCE_ORDERING_STRATEGY=adaptive
ENABLE_DEVELOPER_UNLIMITED_BYPASS=true
ADMIN_EMAIL=
DEVELOPER_EMAILS=
ENVIRONMENT=development
ENABLE_VIDEO_INPUT=true
ENABLE_VISION=true
ENABLE_AUDIO_INPUT=true

# ── Google OAuth 2.0 ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Plans, quotas, and hosted billing ──────────────────────────────────────
# Price values are provider Price IDs, never numeric amounts. Leave billing off
# during local development unless all Stripe configuration is supplied.
LITE_TOKENS_5H=50000
LITE_TOKENS_WEEK=300000
PRO_TOKENS_5H=250000
PRO_TOKENS_WEEK=2000000
CHAT_MAX_INPUT_CHARS=16000
CHAT_MAX_OUTPUT_TOKENS=4096
BILLING_ENABLED=false
PAYMENT_PROVIDER=stripe
# ── Stripe Configuration (Exclusive Payment Provider) ──
# Dashboard: https://dashboard.stripe.com/apikeys
# Webhook: https://<your-domain>/api/billing/webhook (Stripe CLI: stripe listen --forward-to localhost:5001/api/billing/webhook)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LITE_MONTHLY=
STRIPE_PRICE_LITE_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_YEARLY=
PRO_PRICE_USD=29
MAX_PRICE_USD=79
USD_INR_RATE=85.0
BILLING_SUCCESS_URL=http://localhost:5001/billing?checkout=success
BILLING_CANCEL_URL=http://localhost:5001/billing?checkout=cancelled
BILLING_GRACE_PERIOD_HOURS=72
MAX_TOKENS_DAY=500000
MAX_TOKENS_MONTH=15000000
MAX_TOKENS_5H=500000
MAX_TOKENS_WEEK=15000000

# ── Email (password reset & transactional mail) ─────────────────────────────
# EMAIL_ENABLED=false logs email content to the console instead of sending.
# Set EMAIL_ENABLED=true and configure SMTP for real delivery.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@cloudgpt.local
SMTP_TLS=true
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# ── File attachments ────────────────────────────────────────────────────────
UPLOAD_RATE_LIMIT_PER_MINUTE=10
ATTACHMENT_TTL_SECONDS=3600

# ── Observability ───────────────────────────────────────────────────────────
# LOG_FORMAT: console (development, colored) | json (production, structlog)
LOG_FORMAT=console
METRICS_ENABLED=true

# ── Google Gemini (primary) ────────────────────────────────────────────────
# Must be a valid google-genai model identifier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Tier model assignments (Lite / Core / Apex) ─────────────────────────────
# All tiers use Google Gemini 3.8 Flash as primary differentiated by thinking levels:
# Lite: Low thinking (2,048 tokens)
# Core: Medium thinking (8,192 tokens)
# Apex: High thinking (24,576 tokens)
GEMINI_MODEL_LITE=gemini-3.8-flash
GEMINI_MODEL_CORE=gemini-3.8-flash
GEMINI_MODEL_APEX=gemini-3.8-flash

# ── Fallback chain (same for every tier) ────────────────────────────────────
GEMINI_MODEL_FALLBACK_1=gemini-3.7-flash
GEMINI_MODEL_FALLBACK_2=gemini-3.6-flash
GEMINI_MODEL_FALLBACK_3=gemini-3.5-flash
GEMINI_MODEL_SAFETY_NET=gemini-3.5-flash-lite
GEMINI_FIRST_CHUNK_TIMEOUT_SECONDS=6.0
FALLBACK_MAX_OUTPUT_TOKENS=400
FALLBACK_DISABLE_THINKING=true
FALLBACK_ENFORCE_SUPPORT_PERSONA=true

# ── Model Roles & Version Pinning ────────────────────────────────────────────
# Set these to exact snapshot versions once you have confirmed behavior.
# Example snapshot format (when Google exposes it): gemini-3.8-flash-001
# Until exact snapshot IDs are available, use the family strings below and
# retest on any provider-announced model update.
GEMINI_MODEL_SUB=gemini-3.8-flash
GEMINI_MODEL_EVALUATOR=gemini-3.7-flash
TEMPERATURE_GENERATION=0.7
TEMPERATURE_EVALUATOR=0.1
TEMPERATURE_SUB_MODEL=0.0
STRUCTURED_OUTPUT_MAX_RETRIES=2
SCHEMA_VALIDITY_WINDOW=1000
SELF_CRITIQUE_TIMEOUT_SECONDS=15.0

# ── Model Capability Benchmark ────────────────────────────────────────────────
MODEL_EVAL_SAMPLE_SIZE=50
MODEL_EVAL_ACCURACY_BASELINE=0.0

# ── Thinking Mode (Low | Medium | High | Max) ───────────────────────────────
# Reasoning token budgets per level and quota multipliers applied on reserve.
THINKING_BUDGET_LOW=2048
THINKING_BUDGET_MEDIUM=8192
THINKING_BUDGET_HIGH=24576
THINKING_BUDGET_MAX=65535
THINKING_MULT_LOW=1.0
THINKING_MULT_MEDIUM=1.5
THINKING_MULT_HIGH=2.5
THINKING_MULT_MAX=4.0

# ── Anthropic Claude (alternative fallback) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── OpenAI (alternative fallback) ───────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Embedding ───────────────────────────────────────────────────────────────
# Choose: gemini | local | openai | voyage
# Default: gemini with text-embedding-004 (canonical Google GenAI model, 768 dimensions)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# ── Qdrant Vector Database (Primary) ──────────────────────────────────────
# Self-hosted via Docker or Qdrant Cloud (https://cloud.qdrant.io)
# For local dev / tests, falls back automatically to in-memory or on-disk storage
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=cloud-docs
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=false
QDRANT_LOCAL_PATH=data/qdrant_storage

# ── Pinecone Vector Database (Legacy / Optional Fallback) ───────────────────
# Sign up free at https://www.pinecone.io — 5GB storage on free tier
PINECONE_API_KEY=
PINECONE_INDEX_NAME=cloud-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=dotproduct

# ── Retrieval Settings ──────────────────────────────────────────────────────
RETRIEVAL_TOP_K=50
RERANK_TOP_K=10
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANK_PROVIDER=flashrank
SPARSE_PROVIDER=bm25s
RETRIEVAL_TIMEOUT_SECONDS=8.0
AGENTIC_RAG_TIMEOUT_SECONDS=15.0
ADAPTIVE_RAG_TIMEOUT_SECONDS=10.0
LLM_STREAM_TIMEOUT_SECONDS=120.0

# ── HNSW & Quake Vector Indexing ───────────────────────────────────────────
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=32
HNSW_INDEX_PATH=data/hnsw_index/services_hnsw.json
QUAKE_NUM_PARTITIONS=16
QUAKE_MIN_PROBE=1
QUAKE_MAX_PROBE=5
QUAKE_SPLIT_THRESHOLD=50
QUAKE_INDEX_PATH=data/quake_index/services_quake.json

# ── Query Processing & Orchestration (3-Tier RAG) ───────────────────────────
ENABLE_QUERY_NORMALIZATION=true
ENABLE_CONTEXTUAL_QUERY_REWRITING=true
ENABLE_CONDITIONAL_DECOMPOSITION=true
AGENTIC_DECOMPOSITION_COMPLEXITY_THRESHOLD=0.65
ENABLE_ITERATIVE_QUERY_REFINEMENT=true
AGENTIC_MAX_REFINEMENT_HOPS=1
AGENTIC_REFINEMENT_SUFFICIENCY_THRESHOLD=0.55
ENABLE_ADAPTIVE_QUERY_ROUTING=true
ENABLE_SELECTIVE_QUERY_TRANSFORMATION=true
ENABLE_RETRIEVAL_FEEDBACK_REPLANNING=true
ADAPTIVE_REPLAN_FEEDBACK_THRESHOLD=0.40

# ── Evidence Compression & Context Assembly (Layer 3) ───────────────────────
ENABLE_LITE_EVIDENCE_COMPRESSION=true
LITE_COMPRESSION_TOKEN_THRESHOLD=3000
ENABLE_CORE_TASK_AWARE_COMPRESSION=true
ENABLE_CORE_PLAN_AWARE_ASSEMBLY=true

# ── Validated Grounded Generation (Layer 4) ─────────────────────────────────
ENABLE_LITE_OUTPUT_VALIDATION=true
LITE_MIN_CLAIM_SUPPORT=0.50
ENABLE_CORE_OUTPUT_VALIDATION=true
ENABLE_CORE_CLAIM_VERIFICATION=true
CORE_GENERATION_MAX_RETRIES=1
CORE_MIN_CLAIM_SUPPORT=0.55
ENABLE_ADAPTIVE_OUTPUT_VALIDATION=true
ADAPTIVE_GENERATION_MAX_RETRIES=2
ADAPTIVE_MIN_CLAIM_SUPPORT=0.60
ADAPTIVE_ABSTAIN_MIN_SUPPORT=0.30
ENABLE_ADAPTIVE_RERANKING=true
ENABLE_ADAPTIVE_EVIDENCE_SELECTION=true
ENABLE_DYNAMIC_POLICY_PROMPT=true
VALIDATION_MIN_ASSESSABLE_CLAIMS=3
CLAIM_VERIFICATION_TIMEOUT_SECONDS=8.0

# ── Tiered Cache Architecture ───────────────────────────────────────────────
ENABLE_LITE_EXACT_CACHE=true
ENABLE_CORE_DECISION_CACHE=true
CORE_DECISION_CACHE_TTL_SECONDS=900
ENABLE_CORE_TOOL_CACHE=true
ENABLE_ADAPTIVE_CACHE_ROUTER=true
ENABLE_APEX_STAGE_CACHES=true
APEX_STAGE_CACHE_TTL_SECONDS=1800
ADAPTIVE_SEMANTIC_THRESHOLD_DIRECT=0.97
ADAPTIVE_SEMANTIC_THRESHOLD_MULTI_PERSPECTIVE=0.95
ENABLE_FEEDBACK_CACHE_POLICY=true
FEEDBACK_PENALTY_TTL_SECONDS=86400
FEEDBACK_BOOST_TTL_MULTIPLIER=1.5
SKIP_ANSWER_CACHE_ON_VALIDATION_FAILURE=true

# ── Web Search ──────────────────────────────────────────────────────────────
# Primary: SearXNG metasearch instance (e.g. http://localhost:8080)
# Fallback: Resilient direct DuckDuckGo HTML search (free, zero API keys required)
# Legacy API: Tavily API (optional)
# ALWAYS_WEB_SEARCH=true keeps the legacy always-search behaviour; set to false
# to let the query router's needs_internet classification gate searching.
SEARXNG_URL=
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
ALWAYS_WEB_SEARCH=true
DUCKDUCKGO_FALLBACK=true
DUCKDUCKGO_DIRECT_SEARCH=true
DUCKDUCKGO_HTML_ENDPOINT=https://html.duckduckgo.com/html/
WEB_SEARCH_TIMEOUT_SECONDS=5.0

# ── IaC Validation & Repair Loop ─────────────────────────────────────────────
IAC_VALIDATION_ENABLED=true
IAC_VALIDATOR_TIMEOUT_SECONDS=120
IAC_TERRAFORM_INIT_ENABLED=false
IAC_MAX_REPAIR_ITERATIONS=3

# ── AWS Credentials (optional — for live AWS API tools) ─────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1

# ── GCP Credentials (optional — for live GCP API tools) ─────────────────────
GCP_PROJECT_ID=your-project-id
GCP_CREDENTIALS_PATH=./gcp-service-account.json

# ── Azure Credentials (optional — for live Azure API tools) ─────────────────
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=...

# ── Crawler Settings ────────────────────────────────────────────────────────
CRAWLER_RATE_LIMIT=2.0
CRAWLER_MAX_CONCURRENT=5
CRAWLER_TIMEOUT=30
CRAWLER_MAX_RETRIES=3

# ── Chunking Settings ──────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ── Context Engineering & Prompt Budgets ──────────────────────────────────
MAX_HISTORY_MESSAGES=20
HISTORY_TOKEN_BUDGET=1500
HISTORY_COMPACTION_ENABLED=true
HISTORY_COMPACTION_THRESHOLD_MESSAGES=10
ENABLE_GLOBAL_CONTEXT_BUDGET=true
ENABLE_CONTEXT_BUDGET=true
PROMPT_BUDGET_FREE=4000
PROMPT_BUDGET_PRO=7000
PROMPT_BUDGET_MAX=12000
ENABLE_DYNAMIC_CONTEXT_SCALING=true
PROMPT_BUDGET_PRO_EXPANDED=32000
PROMPT_BUDGET_MAX_EXPANDED=64000
ENABLE_RAG_SPECIALIZED_CONTEXT=true
LITE_CONTEXT_BUDGET_BASELINE=4000
LITE_CONTEXT_BUDGET_MAX=8000
AGENTIC_CONTEXT_BUDGET_BASELINE=8000
AGENTIC_CONTEXT_BUDGET_MAX=32000
ADAPTIVE_CONTEXT_BUDGET_BASELINE=16000
ADAPTIVE_CONTEXT_BUDGET_MAX=64000
ENABLE_ATTENTION_U_CURVE_PACKING=true
ENABLE_KV_CACHE_PREFIX_OPTIMIZATION=true
ENABLE_STRUCTURED_CONTEXT_STATE=true
HISTORY_TOKEN_BUDGET=1500
HISTORY_TOKEN_BUDGET_PRO=4000
HISTORY_TOKEN_BUDGET_MAX=8000
PROMPT_BUDGET_WEIGHTS={"rag":0.45,"internet":0.15,"web":0.10,"tools":0.10,"attachments":0.20}
CONTEXT_TOKENS_FREE=2000
CONTEXT_TOKENS_PRO=4000
CONTEXT_TOKENS_MAX=8000
ENABLE_USER_MEMORY=true
USER_MEMORY_MAX_TOKENS=300

# ── Semantic & In-Memory Cache Settings ────────────────────────────────────
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES=500
SEMANTIC_CACHE_THRESHOLD_PRICING=0.95
SEMANTIC_CACHE_THRESHOLD_TROUBLESHOOTING=0.95
SEMANTIC_CACHE_THRESHOLD_CONCEPTUAL=0.90
ENABLE_L1_CACHE=true
MEMORY_CACHE_MAX_ENTRIES=1000
MEMORY_CACHE_TTL_SECONDS=300
CACHE_ROUTER_VERSION=v1
CACHE_CORPUS_VERSION=v1
CACHE_PROMPT_VERSION=v1
ACTIVE_CORPUS_VERSION=v1

# ── Small-Talk Gate ─────────────────────────────────────────────────────────
# Bypass the full agent pipeline (retrieval, tools, rerank) for greetings and
# social messages. Layer 1 = full-match regex; Layer 2 = cosine similarity vs
# canonical utterances reusing the semantic-cache embedding. Fails open on doubt.
SMALLTALK_GATE_ENABLED=true
SMALLTALK_MAX_QUERY_CHARS=120
SMALLTALK_SIMILARITY_THRESHOLD=0.92
SMALLTALK_FAILOPEN_BAND=0.80
# Optional path to a JSON file with a custom canonical utterance list.
#SMALLTALK_UTTERANCES_OVERRIDE=

# ── Plans, Entitlements & Pricing ──────────────────────────────────────────
USER_TIER=Free
PRICING_CURRENCY=USD
PRO_PRICE_USD=29
MAX_PRICE_USD=79
USD_INR_RATE=85.0
LITE_TOKENS_DAY=100000
LITE_TOKENS_MONTH=2000000
PRO_TOKENS_DAY=1000000
PRO_TOKENS_MONTH=20000000

# ── Web Search (SearXNG + DuckDuckGo fallback) ─────────────────────────────
# SEARXNG_URL: URL of your SearXNG metasearch instance (e.g. http://localhost:8080)
# When unset or empty, CloudGPT automatically falls back to DuckDuckGo (free, zero keys).
SEARXNG_URL=http://localhost:8080
ALWAYS_WEB_SEARCH=false
WEB_SEARCH_MAX_RESULTS=5
DUCKDUCKGO_FALLBACK=true

# ── Pipeline Tuning & Latency Budgets ──────────────────────────────────────
DENSE_WEIGHT_EXACT=0.4
DENSE_WEIGHT_NLQ=0.7
ENABLE_ADAPTIVE_TOP_K=true
ADAPTIVE_RETRIEVAL_TOP_K=15
SKIP_SELF_CRITIQUE_THRESHOLD=0.85
BUDGET_CLASSIFICATION_MS=500
BUDGET_RETRIEVAL_MS=1500
BUDGET_RERANKING_MS=800
BUDGET_WEB_SEARCH_MS=2000
WEB_SEARCH_MIN_CONFIDENCE=0.60
ENABLE_STRUCTURED_STAGE_EVENTS=true
GEMINI_REQUEST_TIMEOUT_SECONDS=30.0

# ── Context Validator ───────────────────────────────────────────────────────
ENABLE_CONTEXT_VALIDATOR=true
CONTEXT_VALIDATOR_FAIL_CLOSED=true
CONTEXT_STALENESS_THRESHOLD_DAYS=90

# ── Context Quality Controller ──────────────────────────────────────────────
ENABLE_CONTEXT_QUALITY_CONTROLLER=true
CQC_COHERENCE_THRESHOLD=0.55
CQC_MAX_PROVIDER_DUPLICATION=0.7

# ── Live Verify ─────────────────────────────────────────────────────────────
ENABLE_LIVE_VERIFY=true
LIVE_VERIFY_CONFIDENCE_TRIGGER=0.45
LIVE_VERIFY_MAX_RESULTS=3

# ── Multimodal & Attachments ───────────────────────────────────────────────
ENABLE_VISION=true
ENABLE_AUDIO_INPUT=true
ENABLE_TTS=true
ENABLE_ARTIFACTS=true
MAX_IMAGE_DIMENSION=4096
ATTACHMENT_ALLOWED_EXTENSIONS=pdf,txt,md,json,csv,py,png,jpg,jpeg,webp,mp3,wav,m4a,ogg

# ── Security & CSRF ────────────────────────────────────────────────────────
CSRF_HEADER_NAME=X-CSRF-Token

# ── Application ─────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=5001
DEBUG=false
LOG_LEVEL=INFO

# ── Redis Cache TTLs ────────────────────────────────────────────────────────
REDIS_CACHE_TTL_SECONDS=86400
REDIS_SESSION_TTL_SECONDS=7200
REDIS_TOOL_TTL_SECONDS=3600

# ── Background worker (ARQ) ────────────────────────────────────────────────
ARQ_TASK_TIMEOUT_SECONDS=120

# ── Demo / Seeding ──────────────────────────────────────────────────────────
SEED_DEMO_ACCOUNTS=false


# ── Context Validator & Quality Controller ──────────────────────────────────
CONTEXT_VALIDATOR_SECRET_PATTERNS=
CQC_CONTRADICTION_CHECK_TIERS=Pro,Max

# ── Live Verify (Apex) ───────────────────────────────────────────────────────
LIVE_VERIFY_PROVIDER_DOMAINS=
LIVE_VERIFY_STALENESS_TRIGGER=true

# ── Model Eval & Routing ─────────────────────────────────────────────────────
MODEL_EVAL_GOLDEN_SET_PATH=evaluation/golden_set.json
RECOMMENDATION_COMPARISON_BIAS=true
RISK_GATE_KEYWORDS=

# ── LLM Price Table (USD per million tokens, for usage_events.estimated_cost) ─
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=
LLM_PRICE_THINKING_PER_M=
