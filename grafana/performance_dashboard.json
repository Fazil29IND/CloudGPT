  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Latency & TTFT Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "Time to First Token (TTFT) by Tier (p50 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ttft_seconds_bucket[5m])) by (le, tier))",
          "legendFormat": "{{tier}} - p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ttft_seconds_bucket[5m])) by (le, tier))",
          "legendFormat": "{{tier}} - p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ttft_seconds_bucket[5m])) by (le, tier))",
          "legendFormat": "{{tier}} - p99",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "End-to-End Latency by Pipeline Tier (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(chat_latency_seconds_bucket[5m])) by (le, tier))",
          "legendFormat": "{{tier}} - p95",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Cache Performance (L1 / L2 / Semantic)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 3,
      "title": "L1 In-Memory Cache Hit Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(memory_cache_hits_total[5m]) / (rate(memory_cache_hits_total[5m]) + rate(memory_cache_misses_total[5m]) > 0)",
          "legendFormat": "L1 Hit Rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 4,
      "title": "L2 Redis Cache Hit Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(cache_hits_total{cache_type=\"llm_answer\"}[5m]) / (rate(cache_hits_total{cache_type=\"llm_answer\"}[5m]) + rate(cache_misses_total{cache_type=\"llm_answer\"}[5m]) > 0)",
          "legendFormat": "L2 Redis Hit Rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars" },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 5,
      "title": "Semantic Cache Hits (ops/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(semantic_cache_hits_total[5m])",
          "legendFormat": "Semantic Cache Hits",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "RAG Stage Breakdown & Token Consumption",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "stacking": { "mode": "normal" } },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
