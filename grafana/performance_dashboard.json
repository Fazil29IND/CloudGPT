      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 7,
      "title": "Token Usage Rate (tokens/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(token_usage_total[5m])) by (tier, type)",
