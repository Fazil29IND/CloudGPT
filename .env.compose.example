# ============================================================================
# CloudGPT — Docker Compose Environment Template
# ============================================================================
# Copy this file to .env (compose reads .env automatically for ${VAR}
# interpolation) or run: docker compose --env-file .env.compose up -d
# docker-compose.yml wires DATABASE_URL / REDIS_URL to the in-compose
# hostnames itself — you only set the credentials below.
# Any secret left empty or set to a known default will make the app fail fast
# at startup (config.validate_startup()) instead of silently running insecure.
# ============================================================================

# ── Required (no defaults) ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# PostgreSQL credentials used by both the postgres service and the app.
# Referenced from docker-compose.yml as ${POSTGRES_PASSWORD} / ${POSTGRES_USER}.
POSTGRES_USER=cloudgpt
POSTGRES_PASSWORD=
POSTGRES_DB=cloudgpt_db

# ── App environment ─────────────────────────────────────────────────────────
ENVIRONMENT=production
APP_PORT=5001
REDIS_ENABLED=true
SEED_DEMO_ACCOUNTS=false
ENABLE_CLOUD_API_TOOLS=false

# ── Public URL (Caddy / TLS) ────────────────────────────────────────────────
# Caddy obtains Let's Encrypt certificates for this hostname.
# For local testing use e.g. localhost (Caddy issues an internal CA cert).
DOMAIN=localhost
CORS_ORIGINS=https://localhost
TRUSTED_HOSTS=localhost,cloudgpt_app

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=

# ── OAuth / providers ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=
DEVELOPER_EMAILS=

# ── Stripe (required when BILLING_ENABLED=true) ─────────────────────────────
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LITE_MONTHLY=
STRIPE_PRICE_LITE_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_YEARLY=

# ── LLM providers ───────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Search / RAG ────────────────────────────────────────────────────────────
TAVILY_API_KEY=
PINECONE_API_KEY=

# ── Email (password reset; see .env.example for full SMTP options) ──────────
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@cloudgpt.local
